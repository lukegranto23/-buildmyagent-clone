// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id               String   @id @default(cuid())
  name             String
  offerName        String
  clientName       String?
  industryId       String
  roleId           String
  toneId           String
  description      String?
  systemPrompt     String
  blueprint        String
  quickWins        String
  deliverables     String
  talkingPoints    String
  salesScripts     String
  handoffChecklist String
  integrations     String
  supportPackages  String
  priceSetup       Int
  priceRetainer    Int
  ownerNotes       String?
  status           String   @default("draft")
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccountId     String?
  subAccount       SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  isPublic         Boolean  @default(false)
  marketplacePrice Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessions         ConversationSession[]
  appointments     Appointment[]
  calendarConfig   CalendarConfig?
  workflows        Workflow[]
}

model ConversationSession {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id])
  channel    String   @default("sandbox")
  status     String   @default("completed")
  outcome    String?
  metadata   String?
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  messages   Message[]
}

model Message {
  id        String               @id @default(cuid())
  sessionId String
  session   ConversationSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime             @default(now())
}

model CalendarConfig {
  id              String   @id @default(cuid())
  agentId         String   @unique
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  timezone        String   @default("America/Chicago")
  meetingDuration Int      @default(30)
  bufferBefore    Int      @default(10)
  bufferAfter     Int      @default(10)
  availability    String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Appointment {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  externalId      String?  @unique
  customerName    String?
  customerContact String?
  start           DateTime
  end             DateTime
  channel         String   @default("unknown")
  status          String   @default("scheduled")
  source          String?
  notes           String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId, start])
  @@index([status, start])
}

model Workflow {
  id          String   @id @default(cuid())
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccountId String?
  subAccount  SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  nodes       String   // JSON array of workflow nodes
  edges       String   // JSON array of workflow edges
  status      String   @default("draft") // draft, active, paused
  schedule    String?  // Cron expression for scheduled workflows
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  executions  WorkflowExecution[]
  versions    WorkflowVersion[] @relation("WorkflowVersions")
  activeVersionId String? @unique
  activeVersion   WorkflowVersion? @relation("ActiveWorkflowVersion", fields: [activeVersionId], references: [id])
  presence    WorkflowPresence[]

  @@index([agentId])
  @@index([userId])
  @@index([subAccountId])
  @@index([status])
}

model WorkflowExecution {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String   @default("running") // running, completed, failed, cancelled
  input      String?  // JSON input data
  output     String?  // JSON output data
  error      String?
  startedAt  DateTime @default(now())
  completedAt DateTime?
  logs       WorkflowExecutionLog[]

  @@index([workflowId, startedAt])
  @@index([status])
}

model WorkflowExecutionLog {
  id          String            @id @default(cuid())
  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String?
  level       String            @default("info") // info, warning, error
  message     String
  data        String?          // JSON data
  createdAt   DateTime          @default(now())

  @@index([executionId, createdAt])
}

model Integration {
  id          String   @id @default(cuid())
  name        String
  type        String   // webhook, rest, database, email, slack, etc.
  config      String   // JSON configuration
  credentials String?  // Encrypted credentials JSON
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  connections IntegrationConnection[]

  @@index([type, status])
}

model WorkflowVersion {
  id            String   @id @default(cuid())
  workflowId    String
  workflow      Workflow @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  workflowActive Workflow? @relation("ActiveWorkflowVersion")
  versionNumber Int
  name          String?
  description   String?
  notes         String?
  nodes         String
  edges         String
  metadata      String?
  createdAt     DateTime @default(now())

  @@unique([workflowId, versionNumber])
  @@index([workflowId, versionNumber])
}

model WorkflowPresence {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sessionId  String
  displayName String?
  color      String?
  lastSeen   DateTime @default(now())

  @@unique([workflowId, sessionId])
  @@index([workflowId, lastSeen])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  credits       Int       @default(0)
  subscription  String?   // free, starter, pro, enterprise
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  agents        Agent[]
  workflows     Workflow[]
  subAccounts   SubAccount[] @relation("SubAccountOwner")
  creditTransactions CreditTransaction[]
  integrationConnections IntegrationConnection[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SubAccount {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  owner       User     @relation("SubAccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  credits     Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agents      Agent[]
  workflows   Workflow[]
  creditTransactions CreditTransaction[]
  integrationConnections IntegrationConnection[]

  @@index([ownerId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccountId String?
  subAccount  SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  amount      Int      // Positive for credits added, negative for credits used
  type        String   // purchase, usage, refund, bonus
  description String?
  metadata    String?  // JSON metadata
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subAccountId, createdAt])
}

model IntegrationConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subAccountId String?
  subAccount  SubAccount? @relation(fields: [subAccountId], references: [id], onDelete: Cascade)
  integrationId String
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  credentials String?  // Encrypted credentials JSON
  status      String   @default("active")
  metadata    String?  // JSON metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, integrationId, subAccountId])
  @@index([userId])
  @@index([subAccountId])
  @@index([integrationId])
}

